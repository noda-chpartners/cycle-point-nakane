---
import Base from "../layouts/Base.astro";
import StructuredData from "../components/StructuredData.astro";
import PageLoader from "../components/PageLoader.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HeroSection from "../components/HeroSection.astro";
import FactsSection from "../components/FactsSection.astro";
import ConceptSection from "../components/ConceptSection.astro";
import LineupSection from "../components/LineupSection.astro";
import ShopSection from "../components/ShopSection.astro";
import AppSection from "../components/AppSection.astro";
import AccessSection from "../components/AccessSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BackToTop from "../components/BackToTop.astro";
import { title, description } from "../data/site";
---

<Base title={title} description={description}>
  <StructuredData slot="head" />
  <PageLoader />
  <SiteHeader />

  <main>
    <HeroSection />
    <FactsSection />
    <ConceptSection />
    <LineupSection />
    <ShopSection />
    <AppSection />
    <AccessSection />
  </main>

  <SiteFooter />
  <BackToTop />
</Base>
