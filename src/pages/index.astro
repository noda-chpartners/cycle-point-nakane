---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import logoMark from "../assets/images/logo-mark.png";
import logoLockup from "../assets/images/logo-lockup.png";
import hero from "../assets/images/6B461B56-8C31-4CAB-B4DE-548C2E713A43.jpeg";
import sign from "../assets/images/8AD7DC4C-C1E2-4A34-9A63-7D7283F845C0.jpeg";
import street from "../assets/images/822D1A2E-A383-421C-A00B-4E0822B92004.jpeg";
import entrance from "../assets/images/7ED6D74C-151A-4916-8B39-C4899D74DFAC.jpeg";
import wall from "../assets/images/A74988F7-C3C2-463B-8F86-422BAC48C83E.jpeg";
import appPhoto from "../assets/images/IMG_2680.jpg";

const title = "サイクルポイントナカネ｜大田区山王・大森の自転車屋";
const description =
  "大田区山王の自転車屋、サイクルポイントナカネ。創業大正9年。こども自転車・ママチャリ・電動アシスト・スポーツ車。JR大森駅徒歩10分。10:00〜18:30、火曜定休。電話 03-3771-1644。";

const instagram = "https://www.instagram.com/c.p.nakane/";
const facebook = "https://www.facebook.com/c.p.nakane/";
const appStore = "https://apps.apple.com/jp/app/サイクルポイント-ナカネ/id1640031428";
const googlePlay = "https://play.google.com/store/apps/details?id=com.couponapp2.chain.tac22171&pcampaignid=web_share";
const heroSlides = [
  {
    src: hero,
    alt: "サイクルポイントナカネ山王店の店先。木の看板の下に自転車が並んでいる",
    position: "center 40%",
  },
  {
    src: street,
    alt: "歩道に並んだ自転車と黒板。山王店の外観",
    position: "center 55%",
  },
  {
    src: entrance,
    alt: "開いた入口から見える店内と、店先に並ぶ自転車",
    position: "center 48%",
  },
];
const mapUrl =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent("東京都大田区山王3-9-2 サイクルポイントナカネ");

const siteUrl = new URL("/", Astro.site ?? Astro.url).href;
const shareImage = new URL("/ogp.png", Astro.site ?? Astro.url).href;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "サイクルポイントナカネ",
      alternateName: "Cycle Point Nakane",
      inLanguage: "ja",
      description,
      publisher: { "@id": `${siteUrl}#store` },
    },
    {
      "@type": "BicycleStore",
      "@id": `${siteUrl}#store`,
      name: "サイクルポイントナカネ",
      alternateName: ["Cycle Point Nakane", "サイクルポイント ナカネ"],
      description,
      slogan: "この街の、自転車屋さん。",
      url: siteUrl,
      image: shareImage,
      logo: new URL("/apple-touch-icon.png", Astro.site ?? Astro.url).href,
      telephone: "+81-3-3771-1644",
      currenciesAccepted: "JPY",
      paymentAccepted: "現金",
      foundingDate: "1920",
      hasMap: mapUrl,
      address: {
        "@type": "PostalAddress",
        postalCode: "143-0023",
        addressCountry: "JP",
        addressRegion: "東京都",
        addressLocality: "大田区",
        streetAddress: "山王3-9-2 スプレスター大森山王1F",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: 35.581635,
        longitude: 139.722046,
      },
      areaServed: {
        "@type": "AdministrativeArea",
        name: "大田区",
        containedInPlace: {
          "@type": "AdministrativeArea",
          name: "東京都",
        },
      },
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        opens: "10:00",
        closes: "18:30",
      },
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+81-3-3771-1644",
        contactType: "customer service",
        areaServed: "JP",
        availableLanguage: "Japanese",
      },
      knowsAbout: ["こども自転車", "ママチャリ", "電動アシスト自転車", "スポーツ車"],
      sameAs: [instagram, facebook, appStore, googlePlay],
    },
  ],
};
---

<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />

  <div class="progress" data-progress aria-hidden="true"></div>

  <div class="loader" data-loader>
    <div class="loader__card">
      <Image src={logoLockup} alt="" class="loader__logo" widths={[280, 384]} sizes="280px" />
    </div>
    <p class="loader__label">LOADING</p>
    <div class="loader__track" aria-hidden="true"><span data-loader-bar></span></div>
  </div>

  <noscript>
    <style>
      .loader { display: none !important; }
    </style>
  </noscript>

  <header class="header" data-header>
    <div class="header__bar">
      <a class="brand" href="#top">
        <span class="brand__mark">
          <Image src={logoMark} alt="" widths={[124, 248]} sizes="62px" />
        </span>
        <span class="brand__text">
          <span class="brand__name">サイクルポイントナカネ</span>
          <span class="brand__since">SINCE 1920</span>
        </span>
      </a>

      <nav class="nav" aria-label="メインメニュー">
        <a href="#top">HOME</a>
        <a href="#concept">CONCEPT</a>
        <a href="#lineup">LINEUP</a>
        <a href="#shop">SHOP</a>
        <a href="#access">ACCESS</a>
      </nav>

      <a class="btn header__ig" href={instagram} target="_blank" rel="noopener noreferrer">
        Instagram
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.4" cy="6.6" r="0.8" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>

      <button class="menu-btn" type="button" data-menu aria-expanded="false" aria-controls="mobile-menu" aria-label="メニューを開く">
        <span class="menu-btn__lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </header>

  <div class="drawer" id="mobile-menu" data-drawer inert>
    <nav aria-label="モバイルメニュー">
      <a href="#top">HOME</a>
      <a href="#concept">CONCEPT</a>
      <a href="#lineup">LINEUP</a>
      <a href="#shop">SHOP</a>
      <a href="#access">ACCESS</a>
    </nav>
    <div class="drawer__meta">
      <a class="btn" href={appStore} target="_blank" rel="noopener noreferrer">App Store</a>
      <a class="btn btn--line" href={googlePlay} target="_blank" rel="noopener noreferrer">Google Play</a>
      <a class="btn btn--line" href={instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
      <a class="btn btn--line" href={facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
      <a class="btn btn--line" href="tel:0337711644">03-3771-1644</a>
    </div>
  </div>

  <main>
    <section class="hero" id="top">
      <div class="hero__media" data-hero-slides>
        {heroSlides.map((slide, index) => (
          <Image
            src={slide.src}
            alt={index === 0 ? slide.alt : ""}
            class="hero__photo"
            style={`object-position: ${slide.position}`}
            widths={[480, 750]}
            sizes="100vw"
            loading="eager"
            fetchpriority={index === 0 ? "high" : "low"}
            aria-hidden={index === 0 ? undefined : "true"}
          />
        ))}
        <div class="hero__shade"></div>
      </div>
      <div class="hero__copy">
        <p class="hero__kicker">Cycle Point Nakane</p>
        <h1 class="hero__title">
          <span class="line"><span>この街の、</span></span>
          <span class="line"><span>自転車屋さん。</span></span>
        </h1>
        <p class="hero__lead">創業大正9年。大田区山王で、100年をこえて。</p>
        <div class="hero__actions">
          <a class="btn btn--ghost" href="tel:0337711644">03-3771-1644</a>
        </div>
      </div>
      <a class="hero__scroll" href="#concept">
        SCROLL
        <span></span>
      </a>
      <svg class="hero__wave" viewBox="0 0 1440 110" preserveAspectRatio="none" aria-hidden="true">
        <path fill="#f4efe6" d="M0 62c160 36 300-28 470-8 190 22 330-40 520-8 120 20 250 8 450-6v70H0Z"></path>
      </svg>
    </section>

    <section aria-label="店舗の基本情報">
      <div class="wrap">
        <ul class="facts">
          <li><span>SINCE</span><strong>大正9年</strong></li>
          <li><span>OPEN</span><strong>10:00〜18:30</strong></li>
          <li><span>CLOSED</span><strong>火曜日</strong></li>
          <li><span>ACCESS</span><strong>大森駅 徒歩10分</strong></li>
        </ul>
      </div>
    </section>

    <section class="section concept" id="concept">
      <div class="wrap concept__grid">
        <div class="concept__copy" data-reveal>
          <p class="kicker">CONCEPT</p>
          <h2 class="heading"><span>100年、</span><span>この街と一緒に。</span></h2>
          <div class="concept__body lead">
            <p>
              大正9年（1920年）の創業から、<br />
              大田区山王で、<br />
              自転車を届けてきました。<br />
              100年を越えても、<br />
              顔の見えるお店でありたい。<br />
              その気持ちは変わりません。
            </p>
            <p>
              こども自転車、ママチャリ、<br />
              電動アシスト、スポーツ車まで。<br />
              自転車のことは、<br />
              どうぞお気軽にご相談ください。
            </p>
          </div>
          <ul class="concept__points">
            <li>
              <small>01</small>
              <div>
                <strong>創業大正9年</strong>
                <p>1920年から、山王で自転車とともに。</p>
              </div>
            </li>
            <li>
              <small>02</small>
              <div>
                <strong>100年を越える地域密着</strong>
                <p>顔の見える、まちの自転車屋です。</p>
              </div>
            </li>
            <li>
              <small>03</small>
              <div>
                <strong>一台から、スポーツまで</strong>
                <p>こども自転車、ママチャリ、電動アシスト、スポーツ車。</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="concept__visual" data-reveal>
          <span class="concept__year" aria-hidden="true">1920</span>
          <figure class="frame">
            <Image
              src={sign}
              alt="電球の下にある、鉄で作られたサイクルポイントナカネの自転車看板"
              widths={[480, 750]}
              sizes="(min-width: 1080px) 42vw, calc(100vw - 2rem)"
            />
            <figcaption>Since 1920</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section lineup" id="lineup">
      <div class="wrap">
        <div class="center" data-reveal>
          <p class="kicker">LINEUP</p>
          <h2 class="heading">暮らしに合わせた<span class="phrase">一台を。</span></h2>
          <p class="lead">
            はじめての自転車から、走りを楽しむ一台まで。<br />目的に合わせて、スタッフがご案内します。
          </p>
        </div>
        <figure class="band" data-reveal>
          <Image
            src={street}
            alt="歩道に並んだ自転車と黒板。山王店の外観"
            widths={[480, 750]}
            sizes="(min-width: 1120px) 1120px, 100vw"
          />
        </figure>
        <div class="cards" data-stagger>
          <article class="card" data-stagger-item>
            <div class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="44" r="8"></circle>
                <circle cx="46" cy="44" r="8"></circle>
                <path d="M16 44h14l8-16h8M30 44l8-16M30 28v-8"></path>
                <path d="M30 16l8 4-8 4"></path>
              </svg>
            </div>
            <p class="card__no">01</p>
            <h3>こども自転車</h3>
            <p>はじめての一台を、いっしょに。</p>
          </article>
          <article class="card" data-stagger-item>
            <div class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="44" r="8"></circle>
                <circle cx="46" cy="44" r="8"></circle>
                <path d="M16 44h14l8-16h10M30 44l8-16"></path>
                <path d="M44 22h12l-2 7H46Z"></path>
              </svg>
            </div>
            <p class="card__no">02</p>
            <h3>ママチャリ</h3>
            <p>買い物も送り迎えも、毎日の足。</p>
          </article>
          <article class="card" data-stagger-item>
            <div class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="44" r="8"></circle>
                <circle cx="46" cy="44" r="8"></circle>
                <path d="M16 44h14l8-16h10M30 44l8-16"></path>
                <path d="M33 30l-3 6h5l-3 7" fill="currentColor" stroke="none"></path>
              </svg>
            </div>
            <p class="card__no">03</p>
            <h3>電動アシスト</h3>
            <p>坂道も荷物も、らくに。</p>
          </article>
          <article class="card" data-stagger-item>
            <div class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="46" r="8"></circle>
                <circle cx="46" cy="46" r="8"></circle>
                <path d="M16 46h12l10-18h6"></path>
                <path d="M28 46l10-18"></path>
                <path d="M44 28c7 0 10 3 10 8"></path>
              </svg>
            </div>
            <p class="card__no">04</p>
            <h3>スポーツ車</h3>
            <p>風を切る楽しさを、この街から。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="shop">
      <div class="wrap">
        <div data-reveal>
          <p class="kicker">SHOP</p>
          <h2 class="heading">山王の店先から。</h2>
          <p class="lead sublead">
            木の看板と、店先に並ぶ自転車。大森駅から徒歩10分、山王店です。
          </p>
        </div>
        <div class="gallery" data-stagger>
          <figure class="shot" data-stagger-item>
            <Image
              src={entrance}
              alt="開いた入口から見える店内と、店先に並ぶ自転車"
              widths={[480, 750]}
              sizes="(min-width: 720px) 56vw, 100vw"
            />
            <figcaption>ひらかれた入口</figcaption>
          </figure>
          <figure class="shot" data-stagger-item>
            <Image
              src={wall}
              alt="タイルの壁に掛かった、サイクルポイントナカネの鉄製看板"
              widths={[480, 750]}
              sizes="(min-width: 720px) 40vw, 100vw"
            />
            <figcaption>鉄の自転車看板</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section app" id="app">
      <div class="wrap app__grid">
        <figure class="app__photo" data-reveal>
          <Image
            src={appPhoto}
            alt="サイクルポイントナカネ公式アプリの案内スタンドと二次元コード"
            widths={[480, 750]}
            sizes="(min-width: 720px) 42vw, 100vw"
          />
        </figure>
        <div data-reveal>
          <p class="kicker">APP / SNS</p>
          <h2 class="heading">公式アプリが<br />はじまりました。</h2>
          <p class="lead sublead">
            最新情報やお得なお知らせを、スマホで。<br /><span class="phrase">App Store と Google Play から</span><span class="phrase">ダウンロードできます。</span>
          </p>
          <div class="app__links">
            <a class="btn" href={appStore} target="_blank" rel="noopener noreferrer">
              App Store
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M16.4 12.6c0-2.2 1.8-3.2 1.9-3.3-1-1.5-2.6-1.7-3.2-1.7-1.3-.1-2.6.8-3.3.8s-1.7-.8-2.8-.7c-1.5.1-2.8.8-3.6 2.1-1.5 2.6-.4 6.5 1.1 8.6.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7 1.9-1.1 2.6-2.1c.8-1.2 1.1-2.3 1.2-2.4 0 0-2.2-.8-2.2-3.4ZM14.7 6.8c.6-.7 1-1.7.9-2.7-1 .1-2.1.6-2.8 1.4-.6.7-1.1 1.7-.9 2.6 1 .1 2.1-.5 2.8-1.3Z"></path>
              </svg>
            </a>
            <a class="btn btn--light" href={googlePlay} target="_blank" rel="noopener noreferrer">
              Google Play
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M4.2 3.2c-.3.3-.4.7-.4 1.2v15.2c0 .5.1.9.4 1.2l.1.1 8.5-8.5v-.2L4.3 3.1l-.1.1Zm9.3 8.1 2.4-2.4-9.6-5.5c-.3-.2-.6-.1-.8.1l8 7.8Zm2.9-1.7 2.1 1.2c.8.4.8 1.1 0 1.6l-2.1 1.2-2.6-2.6 2.6-1.4ZM5.5 20.5c.2.2.5.3.8.1l9.6-5.5-2.4-2.4-8 7.8Z"></path>
              </svg>
            </a>
            <a class="btn btn--light" href={instagram} target="_blank" rel="noopener noreferrer">
              Instagram
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.4" cy="6.6" r="0.8" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
            <a class="btn btn--light" href={facebook} target="_blank" rel="noopener noreferrer">
              Facebook
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M14.2 21v-7.1h2.4l.4-2.8h-2.8V9.3c0-.8.2-1.4 1.4-1.4H17V5.4c-.3 0-1.1-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.6v2.2H9v2.8h2.4V21h2.8Z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="access">
      <div class="wrap">
        <div data-reveal>
          <p class="kicker">ACCESS</p>
          <h2 class="heading"><span class="phrase">遊びに来るように、</span><span class="phrase">寄ってください。</span></h2>
        </div>
        <div class="access__grid">
          <div data-reveal>
            <dl class="info">
              <div class="info__row">
                <dt>ADDRESS</dt>
                <dd>
                  〒143-0023<br />
                  東京都大田区山王3-9-2<br />
                  スプレスター大森山王1F 山王店
                </dd>
              </div>
              <div class="info__row">
                <dt>ACCESS</dt>
                <dd>JR京浜東北線 大森駅から徒歩10分</dd>
              </div>
              <div class="info__row">
                <dt>TEL</dt>
                <dd><a class="phone" href="tel:0337711644">03-3771-1644</a></dd>
              </div>
              <div class="info__row">
                <dt>OPEN</dt>
                <dd>10:00〜18:30<br />平日・土・日・祝</dd>
              </div>
              <div class="info__row">
                <dt>CLOSED</dt>
                <dd>火曜日<br />祝日の火曜日もお休み</dd>
              </div>
              <div class="info__row">
                <dt>PARKING</dt>
                <dd>駐車場はありません。<br />お店の前に有料駐車場があります。</dd>
              </div>
              <div class="info__row">
                <dt>PAYMENT</dt>
                <dd>現金</dd>
              </div>
            </dl>
          </div>
          <div class="access__map" data-reveal>
            <div class="map">
              <iframe
                title="サイクルポイントナカネの地図"
                src="https://maps.google.com/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E5%A4%A7%E7%94%B0%E5%8C%BA%E5%B1%B1%E7%8E%8B3-9-2&z=16&hl=ja&output=embed"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
            <a class="map__link" href={mapUrl} target="_blank" rel="noopener noreferrer">Googleマップで開く</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer__top">
        <div>
          <Image src={logoLockup} alt="サイクルポイントナカネ" class="footer__logo" widths={[280, 384]} sizes="220px" />
          <address class="footer__address">
            〒143-0023<br />
            東京都大田区山王3-9-2<br />
