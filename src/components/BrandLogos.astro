---
const logos = {
  bridgestone: { name: "ブリヂストン", file: "bridgestone.gif" },
  maruishi: { name: "マルイシ", file: "maruishi.png" },
  khodaabloom: { name: "KhodaaBloom（コーダーブルーム）", file: "khodaabloom.png" },
  riteway: { name: "RITEWAY（ライトウェイ）", file: "riteway.png" },
  louisgarneau: { name: "LOUIS GARNEAU（ルイガノ）", file: "louisgarneau.jpg" },
  ides: { name: "アイデス", file: "ides.svg" },
  hodaka: { name: "ホダカ", file: "hodaka.png" },
  sakamoto: { name: "サカモトテクノ", file: "sakamoto.png" },
  miyata: { name: "ミヤタ", file: "miyata.gif" },
  panasonic: { name: "パナソニック", file: "panasonic.svg" },
  anchor: { name: "ANCHOR", file: "anchor.png" },
  merida: { name: "MERIDA", file: "merida.svg" },
  surly: { name: "SURLY", file: "surly.svg" },
  felt: { name: "FELT", file: "felt.jpg" },
  fuji: { name: "FUJI", file: "fuji.png" },
  gt: { name: "GT", file: "gt.png" },
};

interface Props {
  brands: (keyof typeof logos)[];
}

const { brands } = Astro.props;
---

<ul class="brand-logos" aria-label="取り扱いメーカー">
  {brands.map((id) => (
    <li class:list={["brand-logos__item", { "brand-logos__item--dark": ["anchor", "khodaabloom", "riteway", "surly"].includes(id) }]}>
      <img src={`/images/brands/${logos[id].file}`} alt={logos[id].name} width="180" height="60" loading="lazy" decoding="async" />
    </li>
  ))}
</ul>
