---
import { Image } from "astro:assets";
import logoLockup from "../assets/images/logo-lockup.png";
import { instagram, facebook } from "../data/site";
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div>
        <Image src={logoLockup} alt="サイクルポイントナカネ" class="footer__logo" widths={[280, 384]} sizes="220px" />
        <address class="footer__address">
          〒143-0023<br />
          東京都大田区山王3-9-2<br />
          スプレスター大森山王1F 山王店
        </address>
      </div>
      <nav aria-label="フッターメニュー">
        <a href="#top">HOME</a>
        <a href="#concept">CONCEPT</a>
        <a href="#lineup">LINEUP</a>
        <a href="#shop">SHOP</a>
        <a href="#access">ACCESS</a>
      </nav>
      <div class="footer__sns">
        <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.4" cy="6.6" r="0.8" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M14.2 21v-7.1h2.4l.4-2.8h-2.8V9.3c0-.8.2-1.4 1.4-1.4H17V5.4c-.3 0-1.1-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.6v2.2H9v2.8h2.4V21h2.8Z"></path>
          </svg>
        </a>
      </div>
    </div>
    <div class="footer__bottom">
      <p>© 2026 Cycle Point Nakane</p>
    </div>
  </div>
</footer>
