---
import { description, instagram, facebook, appStore, googlePlay, mapUrl } from "../data/site";

const siteUrl = new URL("/", Astro.site ?? Astro.url).href;
const shareImage = new URL("/ogp.png", Astro.site ?? Astro.url).href;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "サイクルポイントナカネ",
      alternateName: "Cycle Point Nakane",
      inLanguage: "ja",
      description,
      publisher: { "@id": `${siteUrl}#store` },
    },
    {
      "@type": "BicycleStore",
      "@id": `${siteUrl}#store`,
      name: "サイクルポイントナカネ",
      alternateName: ["Cycle Point Nakane", "サイクルポイント ナカネ"],
      description,
      slogan: "この街の、自転車屋さん。",
      url: siteUrl,
      image: shareImage,
      logo: new URL("/apple-touch-icon.png", Astro.site ?? Astro.url).href,
      telephone: "+81-3-3771-1644",
      currenciesAccepted: "JPY",
      paymentAccepted: "現金",
      foundingDate: "1920",
      hasMap: mapUrl,
      address: {
        "@type": "PostalAddress",
        postalCode: "143-0023",
        addressCountry: "JP",
        addressRegion: "東京都",
        addressLocality: "大田区",
        streetAddress: "山王3-9-2 スプレスター大森山王1F",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: 35.581635,
        longitude: 139.722046,
      },
      areaServed: {
        "@type": "AdministrativeArea",
        name: "大田区",
        containedInPlace: {
          "@type": "AdministrativeArea",
          name: "東京都",
        },
      },
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        opens: "10:00",
        closes: "18:30",
      },
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+81-3-3771-1644",
        contactType: "customer service",
        areaServed: "JP",
        availableLanguage: "Japanese",
      },
      knowsAbout: ["こども自転車", "軽快車", "電動アシスト自転車", "スポーツ車"],
      sameAs: [instagram, facebook, appStore, googlePlay],
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
